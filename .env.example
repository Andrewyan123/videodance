# Copy to .env and fill in values. .env should NOT be committed.

# --- Required ---
# Planner LLM (eval.dashscope 二组 key, 走 compatible-mode)
ANTHROPIC_API_KEY=sk-...
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Image + video generation (DashScope 生产 key)
DASHSCOPE_API_KEY=sk-...

# --- Optional: provider selection ---
# LLM_PROVIDER=anthropic_compat         # anthropic_compat | openai_compat
# IMAGE_PROVIDER=dashscope_t2i          # dashscope_t2i | openai_image
# IMAGE_EDIT_PROVIDER=wanx_i2i          # wanx_i2i | qwen_image_edit | gpt_image_edit
# VIDEO_PROVIDER=dashscope_i2v          # dashscope_i2v | seeddance | jimeng

# --- Optional: model name overrides ---
# PLANNER_MODEL=aws.claude-opus-4-6
# T2I_MODEL=wanx2.1-t2i-turbo
# IMAGE_EDIT_MODEL=wanx2.1-imageedit
# I2V_MODEL=wanx2.1-i2v-turbo

# --- Optional: stitcher output dir ---
# STITCH_OUT_DIR=/tmp/video1.0_stitch
